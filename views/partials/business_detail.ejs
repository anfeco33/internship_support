<% var company = data.company %>
<% var companiesComments = data.companiesComments %>
<% const businessId = data.businessId ? data.businessId.toString() : ''; %>
<header>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/home">
                <img src="../../images/logo.png" alt="err" id="header-logo">
            </a>
            <div class="seach_bar d-flex justify-content-center align-items-center mb-3">
                <div class="seach_content  input-group mx-3">
                    <input type="text" class="form-control" name="search" id="searchInput" placeholder="Find companies, for example: FPT" data-bs-toggle="collapse" data-bs-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
                    <div class="input-group-append  d-flex justify-content-center align-items-center" >
                        <span id="clear_icon">
                            <i class="fa fa-times"></i>
                        </span>
                        <span id="seach_icon" class="input-group-text" 
                        style="height: 100%; border-radius:0px 5px 5px 0px; padding: 8.5px;">                       
                            <i class="fa fa-search" style="border-radius: 0px;"></i>
                        </span>
            
                    </div>
                    <div class="collapse custom-collapse" id="collapseExample">
                        <div class="card card-body search_result">
                            <ul id="search_result_row">
                                <!-- search result -->
                            </ul>    
                        </div>
                    </div>
                </div>
            
                <% if(account.role !== 'admin') { %>
                <div class="bell_icon mx-3">
                    <i class="bi bi-bell-fill"></i>
                    <% if (account.role === 'company') { %>
                      <span id="applicationCount" class="badge">0</span>
                    <% } else if (account.role === 'student') { %>
                      <span id="studentFeedbackCount" class="badge">0</span>
                    <% } %>
                </div>
                <% } %>

                <% if (account.role === 'student') { %>
                  <div id="studentFeedbackDropdown" class="applications-dropdown">
                    <ul id="studentFeedbackList" class="list-group">
                      <!-- Feedback items sẽ được hiển thị ở đây -->
                    </ul>
                  </div>
                <% } %>
                
                <% if (account.role === 'company') { %>
                  <!-- Applications Dropdown -->
                  <div id="applicationsDropdown" class="applications-dropdown">
                    <ul id="applicationsList" class="list-group">
                      <!-- Applications will be listed here -->
                    </ul>
                  </div>  
                  <div class="update_profile_icon mx-3" alt="update profile">
                      <button class="btn btn-primary btn-sm" onclick="editByBussinessId('<%= data.businessId %>')">
                          <i class="bi bi-pencil-square"></i>
                      </button>
                  </div>
                <% } %>
            </div>
        </div>
    </nav>
</header>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<div class="container-fluid light-style flex-grow-1 container-p-y company_detail_page" style="margin-top: 80px;">
    <% if (company) { %>
        <div class="company_detail_card">
            <div class="row no-gutters row-bordered row-border-light">
                <!-- Carousel for images and videos -->
                <div class="col col-lg-7 col-12 pt-0">
                    <div id="mediaCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <!-- Promotion Video -->
                            <% if (company.promotionVideos.length > 0) { %>
                                <div class="carousel-item active">
                                    <iframe width="100%" height="400px" src="<%= company.promotionVideos[0] %>"
                                        title="Promotion Video" frameborder="0" allowfullscreen
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                    </iframe>
                                </div>
                            <% } %>
                            <!-- Images -->
                            <% if (company.images && company.images.length > 0) { %>
                                <% company.images.forEach(function (image, index) { %>
                                    <div class="carousel-item <%= company.promotionVideos.length === 0 && index === 0 ? 'active' : '' %>">
                                        <img src="<%= image %>" class="d-block w-100" alt="Company Image">
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                        <!-- Carousel Controls -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#mediaCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#mediaCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                    <!-- Thumbnails -->
                    <div class="thumbnail-container mt-3">
                        <button class="thumbnail-control-prev" onclick="scrollThumbnails('prev')">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <div class="thumbnail-wrapper">
                            <% if (company.promotionVideos.length > 0) { %>
                                <% var videoId = company.promotionVideos[0].split('v=')[1]; %>
                                <% if (videoId) { %>
                                    <div class="thumbnail" onclick="showMedia('video', '<%= company.promotionVideos[0] %>')">
                                        <img src="https://img.youtube.com/vi/<%= videoId %>/0.jpg" class="img-fluid" alt="Promotion Video">
                                    </div>
                                <% } %>
                            <% } %>
                            <% if (company.images && company.images.length > 0) { %>
                                <% company.images.forEach(function (image) { %>
                                    <div class="thumbnail" onclick="showMedia('image', '<%= image %>')">
                                        <img src="<%= image %>" class="img-fluid" alt="Company Image">
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                        <button class="thumbnail-control-next" onclick="scrollThumbnails('next')">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>

                </div>
                <!-- Company Info -->
                <div class="col col-lg-5 col-12 company_info">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0"><%= company.name %></h4>
                        <% if (company.isLocked) { %>
                          <span class="badge bg-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Your business may have violated community guidelines. Your profile will not be visible to other users. If there is a mistake, please contact support at: internchoice@support.gmail.com.">Locked</span>
                        <% } else { %>
                            <% if (company.isVerified) { %>
                              <img src="/images/verified_icon.png" alt="Verified" style="width: 20px; height: 20px;">
                            <% } %>
                        <% } %>
                    </div>
                    <p><strong>Industry</strong> <%= company.industry %></p>
                    <p><strong>Size</strong> <%= company.size || 'Not specified' %></p>
                    <p><strong>Address</strong> <%= company.address || 'Not specified' %></p>
                    <p><strong>Website</strong> <a href="<%= company.website %>" target="_blank"><%= company.website || 'Not specified' %></a></p>
                    <p><strong>Contact Email</strong> <%= company.contactEmail || 'Not specified' %></p>
                    <p><strong>Phone Number</strong> <%= company.phoneNumber || 'Not specified' %></p>
                    <p><strong> <i class="fa fa-star" aria-hidden="true" style="color: gold;"></i></strong> <%= company.averageRating ? company.averageRating.toFixed(1) : '0' %>/5</p>
                    <% if (account.role === 'student') { %>
                      <% if (account.savedCompanies.includes(company._id.toString())) { %>
                        <p class="heart-icon iconheart">
                          <i class="fa fa-heart heart" id="heart-<%= company._id.toString() %>" onclick="saveFavoriteCompany(event, '<%= company._id.toString() %>')" style="font-size:30px;color:red;cursor:pointer;"></i>
                        </p>
                      <% } else { %>
                        <p class="heart-icon iconheart">
                          <i class="fa-regular fa-heart heart" id="heart-<%= company._id.toString() %>" onclick="saveFavoriteCompany(event, '<%= company._id.toString() %>')" style="font-size:30px;color:red;cursor:pointer;"></i>
                        </p>
                      <% } %>
                    <% } %>
                    <% if (account.role === 'company' && company.representativeIds.map(id => id.toString()).includes(account._id.toString())) { %>
                      <div class="button-box styled-box">
                        <div class="my_business_icon mx-3" alt="my business">
                          <button class="btn btn-danger btn-sm create-business-btn styled-button" data-bs-toggle="modal" data-bs-target="#createInternshipModal">
                            <i class="fa fa-plus-circle" style="margin-right: 15px;"></i>CREATE INTERNSHIP
                          </button>
                        </div>
                        <% if (company.representativeIds[0].toString() === account._id.toString()) { %>
                          <div class="add-representative-form">
                            <button class="btn btn-primary add-representative-btn styled-button" data-bs-toggle="modal" data-bs-target="#addRepresentativeModal">
                              <i class="fa fa-user-plus" style="margin-right: 5px;"></i>ADD REPRESENTATIVE
                            </button>
                          </div>
                          <div class="view-representatives-form">
                            <button class="btn btn-info view-representatives-btn styled-button" data-bs-toggle="modal" data-bs-target="#viewRepresentativesModal" onclick="viewRepresentatives('<%= businessId %>')">
                              <i class="fa fa-users" style="margin-right: 5px;"></i>VIEW REPRESENTATIVES
                            </button>
                          </div>
                        <% } %>
                      </div>
                    <% } %>
                </div>
            </div>
        </div>
        <!-- Company Description -->
        <div class="company_detail_card" style="margin-top: 20px;">
            <h4>COMPANY DETAILS DESCRIPTION</h4>
            <p><%= company.profile || 'No description available' %></p>
        </div>
        <!-- Internship Postings -->
        <div class="company_detail_card" style="margin-top: 20px;">
            <h4>INTERNSHIP OPPORTUNITIES OPENINGS</h4>
            <% if (company.internships && company.internships.length > 0) { %>
                <% company.internships.forEach(function (internship) { %>
                    <h1><% internship._id.toString() %></h1>
                    <div class="card mb-3" id="opportunitiesOpening">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="card-title"><%= internship.title %></h5>
                                </div>
                                <% if (account.role === 'company' && company.representativeIds.map(id => id.toString()).includes(account._id.toString())) { %>
                                  <div class="btn-group">
                                        <button class="btn btn-secondary btn-sm" onclick="editInternship('<%= internship._id %>')">Edit</button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteInternship('<%= internship._id %>')">Delete</button>
                                    </div>
                                <% } %>
                            </div>
                            <div class="card-text mt-3"><%- internship.description %></div>
                            <p class="text-muted mt-3"><%= new Date(internship.createdAt).toLocaleString('vi-VN') %></p>
                            <% if (account.role === 'student') { %>
                              <button class="btn btn-primary mt-3" id="applyBtn" onclick="applyForInternship('<%= internship._id %>')" style="font-size: 16px;">Apply Now <i class="fa fa-user-plus" style="font-size: 16px;"></i></button>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p>No internship opportunities available at the moment.</p>
            <% } %>
        </div>
        <!-- Google Map -->
        <div class="company_detail_card" style="margin-top: 20px;">
            <h4>MAP LOCATION</h4>
            <div id="map" style="height: 400px; width: 100%;"></div>
        </div>
        <!-- comment -->
        <div class="company_detail_card" style="margin-top: 20px;">
            <h4>COMMENTS</h4>
            <% if (account.role !== 'admin') { %>
            <div class="mrt5" style="color:red;font-size:12px;font-style:italic">
              Please share your honest feedback and help other students get a better understanding of what it's like to intern here. Please be mindful of your words and avoid making any harmful or untrue statements. Any comments that violate our guidelines will be removed. Thank you for your contribution to our community!
            </div>
            <div class="comment-section">
              <div class="comment-form" style="border: solid 1px #e0e0e0; padding: 20px; margin-top: 5px; margin-bottom: 5px;">
                  <textarea
                    class="form-control"
                    id="commentContent"
                    rows="3"
                    placeholder="Write a comment..."
                  ></textarea>
                  <div class="rating-section mt-2 d-flex justify-content-between align-items-center" style="margin-bottom: 20px;"> 
                    <div>
                      <label for="rating">Overall Rating <i class="fa fa-star" aria-hidden="true" style="color: gold;"></i></label>
                      <select id="rating" class="form-select" style="width: 120px; display: inline-block;">
                        <option value="">No Rating</option>
                        <option value="1">⭐</option>
                        <option value="2">⭐⭐</option>
                        <option value="3">⭐⭐⭐</option>
                        <option value="4">⭐⭐⭐⭐</option>
                        <option value="5">⭐⭐⭐⭐⭐</option>
                      </select>
                    </div>
                    <button class="btn btn-primary" id="cmtSend" onclick="addComment('<%= company._id %>')">
                      <i class="fas fa-paper-plane" style="font-size: 15px;"></i></button>
                  </div>
                  <h4>OR RATE BY CATEGORY</h4>
                  <div class="rating-section mt-2">
                    <label for="workEnvironmentRating">Work Environment</label>
                    <div id="workEnvironmentRating" class="star-rating work-environment-stars">
                      <i class="fa-regular fa-star" onmouseover="highlightStars('workEnvironmentRating', 1)" onmouseout="resetStars('workEnvironmentRating')" onclick="setRating('workEnvironmentRating', 1)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('workEnvironmentRating', 2)" onmouseout="resetStars('workEnvironmentRating')" onclick="setRating('workEnvironmentRating', 2)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('workEnvironmentRating', 3)" onmouseout="resetStars('workEnvironmentRating')" onclick="setRating('workEnvironmentRating', 3)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('workEnvironmentRating', 4)" onmouseout="resetStars('workEnvironmentRating')" onclick="setRating('workEnvironmentRating', 4)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('workEnvironmentRating', 5)" onmouseout="resetStars('workEnvironmentRating')" onclick="setRating('workEnvironmentRating', 5)"style="cursor: pointer;"></i>
                    </div>
                    <input type="hidden" id="workEnvironmentRatingValue" value="0">
                  
                    <label for="trainingSupportRating">Training Support</label>
                    <div id="trainingSupportRating" class="star-rating training-support-stars">
                      <i class="fa-regular fa-star" onmouseover="highlightStars('trainingSupportRating', 1)" onmouseout="resetStars('trainingSupportRating')" onclick="setRating('trainingSupportRating', 1)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('trainingSupportRating', 2)" onmouseout="resetStars('trainingSupportRating')" onclick="setRating('trainingSupportRating', 2)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('trainingSupportRating', 3)" onmouseout="resetStars('trainingSupportRating')" onclick="setRating('trainingSupportRating', 3)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('trainingSupportRating', 4)" onmouseout="resetStars('trainingSupportRating')" onclick="setRating('trainingSupportRating', 4)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('trainingSupportRating', 5)" onmouseout="resetStars('trainingSupportRating')" onclick="setRating('trainingSupportRating', 5)"style="cursor: pointer;"></i>
                    </div>
                    <input type="hidden" id="trainingSupportRatingValue" value="0">
                  
                    <label for="learningOpportunitiesRating">Learning Opportunities</label>
                    <div id="learningOpportunitiesRating" class="star-rating learning-opportunities-stars">
                      <i class="fa-regular fa-star" onmouseover="highlightStars('learningOpportunitiesRating', 1)" onmouseout="resetStars('learningOpportunitiesRating')" onclick="setRating('learningOpportunitiesRating', 1)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('learningOpportunitiesRating', 2)" onmouseout="resetStars('learningOpportunitiesRating')" onclick="setRating('learningOpportunitiesRating', 2)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('learningOpportunitiesRating', 3)" onmouseout="resetStars('learningOpportunitiesRating')" onclick="setRating('learningOpportunitiesRating', 3)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('learningOpportunitiesRating', 4)" onmouseout="resetStars('learningOpportunitiesRating')" onclick="setRating('learningOpportunitiesRating', 4)"style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('learningOpportunitiesRating', 5)" onmouseout="resetStars('learningOpportunitiesRating')" onclick="setRating('learningOpportunitiesRating', 5)"style="cursor: pointer;"></i>
                    </div>
                    <input type="hidden" id="learningOpportunitiesRatingValue" value="0">
                  
                    <label for="benefitsRating">Benefits</label>
                    <div id="benefitsRating" class="star-rating benefits-stars">
                      <i class="fa-regular fa-star" onmouseover="highlightStars('benefitsRating', 1)" onmouseout="resetStars('benefitsRating')" onclick="setRating('benefitsRating', 1)" style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('benefitsRating', 2)" onmouseout="resetStars('benefitsRating')" onclick="setRating('benefitsRating', 2)" style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('benefitsRating', 3)" onmouseout="resetStars('benefitsRating')" onclick="setRating('benefitsRating', 3)" style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('benefitsRating', 4)" onmouseout="resetStars('benefitsRating')" onclick="setRating('benefitsRating', 4)" style="cursor: pointer;"></i>
                      <i class="fa-regular fa-star" onmouseover="highlightStars('benefitsRating', 5)" onmouseout="resetStars('benefitsRating')" onclick="setRating('benefitsRating', 5)" style="cursor: pointer;"></i>
                    </div>
                    <input type="hidden" id="benefitsRatingValue" value="0">
                  </div>
                  <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-secondary" onclick="resetAllRatings()" style="font-size: 17px;">Reset <i class="fa fa-refresh" style="font-size: 17px;"></i> </button>
                  </div>

              </div>
             
            </div>
            <% } %>
<!-- show comments -->
<div class="comments">
  <% if (companiesComments.comments && companiesComments.comments.length > 0) { %>
    <% companiesComments.comments.forEach(function (comment) { %>
      <div id="comment-<%= comment._id %>" class="comment user-comment d-flex flex-column align-items-start w-100">
        <div class="d-flex align-items-start w-100">
          <img src="<%= comment.authorPicture %>" alt="User Avatar" class="admin-avatar">
          <div class="comment-content-group w-100">
            <div class="bordered w-100">
              <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <strong><%= comment.authorName %></strong>
                  <% if (companiesComments.representativeIds.map(id => id.toString()).includes(comment.authorId.toString())) { %>
                    <span style="color: lightcoral; margin-left: 5px;">(Representative)</span>
                  <% } %>
                  <% if (comment.rating) { %>
                    <span class="star-rating selected" style="margin-left: 10px;">
                      <i class="fa fa-star" aria-hidden="true">
                        <span class="star-number"><%= comment.rating %></span>
                      </i>
                    </span>
                  <% } %>
                </div>
                <% if (comment.detailedRatings) { %>
                  <div class="detailed-ratings d-flex align-items-center">
                    <% if (comment.detailedRatings.workEnvironment) { %>
                      <span class="star-rating work-environment-stars">
                        <i class="fa fa-star" aria-hidden="true">
                          <span class="star-number"><%= comment.detailedRatings.workEnvironment %></span>
                        </i>
                      </span>
                    <% } %>
                    <% if (comment.detailedRatings.trainingSupport) { %>
                      <span class="star-rating training-support-stars">
                        <i class="fa fa-star" aria-hidden="true">
                          <span class="star-number"><%= comment.detailedRatings.trainingSupport %></span>
                        </i>
                      </span>
                    <% } %>
                    <% if (comment.detailedRatings.learningOpportunities) { %>
                      <span class="star-rating learning-opportunities-stars">
                        <i class="fa fa-star" aria-hidden="true">
                          <span class="star-number"><%= comment.detailedRatings.learningOpportunities %></span>
                        </i>
                      </span>
                    <% } %>
                    <% if (comment.detailedRatings.benefits) { %>
                      <span class="star-rating benefits-stars">
                        <i class="fa fa-star" aria-hidden="true">
                          <span class="star-number"><%= comment.detailedRatings.benefits %></span>
                        </i>
                      </span>
                    <% } %>
                  </div>
                <% } %>


                <% if (comment.authorId.toString() === account._id.toString()) { %>
                <div class="edit-link-container">
                  <a href="javascript:void(0);" class="edit-link" onclick="toggleEditForm('<%= comment._id %>')">
                    <i class="fa fa-edit" aria-hidden="true"></i>
                  </a>
                </div>
                <% } %>
                <% if (account.role !== 'admin' && comment.authorId.toString() !== account._id.toString() && comment.content !== 'This comment has been removed due to violation of our policies') { %>
                  <a href="javascript:void(0);" class="report-link" onclick="showReportModal('comment', '<%= company._id %>', '<%= comment._id %>')">
                    <i class="fa fa-flag" aria-hidden="true"></i>
                  </a>
                <% } %>
                <% if (account.role === 'admin') { %>
                  <a href="javascript:void(0);" class="delete-link" onclick="showDeleteModal('comment', '<%= company._id %>', '<%= comment._id %>')">
                    <i class="fa fa-trash" aria-hidden="true"></i>
                  </a>
                <% } %>
              </div>
              <div class="d-flex align-items-start" style="font-size:12px;font-style:italic">
                <% if (comment.updatedAt) { %>
                  <span id="comment-updatedAt-<%= comment._id %>" style="color:gray;"><%= comment.updatedAt %></span>
                  <% } else { %>
                  <span style="color:gray;"><%= comment.createdAt %></span>
                <% } %>
                <span class="masked-email" data-email="<%= comment.authorEmail %>"></span>
              </div>
              <hr class="separator">
              <div class="comment-content mt-2 d-flex align-items-center">
                <p id="comment-content-<%= comment._id %>" class="<%= comment.content === 'This comment has been removed due to violation of our policies' ? 'removed-comment' : '' %>"><%= comment.content %></p>
              </div>
              <div class="arrow-left"></div>
              <!-- Form để chỉnh sửa comment, ban đầu ẩn -->
              <div class="edit-form mt-2" id="editForm-<%= comment._id %>" style="display: none;">
                <textarea class="form-control edit-textarea" id="editContent-<%= comment._id %>" rows="2"><%= comment.content %></textarea>
                <div class="d-flex justify-content-end mt-2">
                  <button class="btn btn-primary edit-button" onclick="editComment('<%= company._id %>', '<%= comment._id %>')">
                    Save
                  </button>
                </div>
              </div>
            </div>
            <!-- Nút Reply -->
            <div class="d-flex justify-content-between mt-2 w-100">
              <div class="reply-link-container">
                <a href="javascript:void(0);" class="reply-link" onclick="toggleReplyForm('<%= comment._id %>')">Reply</a>
              </div>
            </div>

            <!-- Form để trả lời comment, ban đầu ẩn -->
            <div class="reply-form mt-2" id="replyForm-<%= comment._id %>" style="display: none;">
              <textarea class="form-control reply-textarea" id="replyContent-<%= comment._id %>" rows="2" placeholder="Write a reply..."></textarea>
              <div class="d-flex justify-content-end mt-2">
                <button class="btn btn-primary reply-button" onclick="replyToComment('<%= company._id %>', '<%= comment._id %>')">
                  <i class="fas fa-paper-plane"></i>
                </button>
              </div>
            </div>

            <!-- show replies -->
            <div class="replies mt-3 w-100">
              <% if (comment.replies && comment.replies.length > 0) { %>
                <% comment.replies.forEach(function (reply) { %>
                  <div id="comment-<%= reply._id %>" class="reply user-comment d-flex align-items-start w-100 mb-3">
                    <div class="d-flex align-items-start w-100">
                      <img src="<%= reply.authorPicture %>" alt="User Avatar" class="admin-avatar">
                      <div class="bordered w-100">
                        <div class="d-flex align-items-center justify-content-between w-100">
                          <div class="d-flex align-items-center">
                            <strong><%= reply.authorName %></strong>
                            <% if (companiesComments.representativeIds.map(id => id.toString()).includes(reply.authorId.toString())) { %>
                              <span style="color: lightcoral; margin-left: 5px;">(Representative)</span>
                            <% } %>
                          </div>
