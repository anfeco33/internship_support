// jscomment
function addComment(companyId) {
  const content = document.getElementById('commentContent').value;
  const rating = document.getElementById('rating').value;
  const workEnvironmentRating = document.getElementById('workEnvironmentRatingValue').value;
  const trainingSupportRating = document.getElementById('trainingSupportRatingValue').value;
  const learningOpportunitiesRating = document.getElementById('learningOpportunitiesRatingValue').value;
  const benefitsRating = document.getElementById('benefitsRatingValue').value;

  if ((workEnvironmentRating > 0 || trainingSupportRating > 0 || learningOpportunitiesRating > 0 || benefitsRating > 0) &&
      (workEnvironmentRating == 0 || trainingSupportRating == 0 || learningOpportunitiesRating == 0 || benefitsRating == 0)) {
    showflashmessage('warning', 'Please rate all detailed criteria!');
    return;
  }

  const detailedRatings = {
    workEnvironment: workEnvironmentRating,
    trainingSupport: trainingSupportRating,
    learningOpportunities: learningOpportunitiesRating,
    benefits: benefitsRating
  };
  console.log("details: ", detailedRatings);

  fetch(`/home/business/${companyId}/comments`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ content, rating, detailedRatings }),
  })
    .then((response) => response.json())
    .then((data) => {
      if (data.status === 'success') {
        showflashmessage(data.status, data.message);
        // reset form
        document.getElementById('commentContent').value = '';
        document.getElementById('rating').value = '0';
        document.getElementById('workEnvironmentRatingValue').value = '0';
        document.getElementById('trainingSupportRatingValue').value = '0';
        document.getElementById('learningOpportunitiesRatingValue').value = '0';
        document.getElementById('benefitsRatingValue').value = '0';
        resetStars('workEnvironmentRating');
        resetStars('trainingSupportRating');
        resetStars('learningOpportunitiesRating');
        resetStars('benefitsRating');

        if (data.commentId) {
          localStorage.setItem('scrollToComment', `comment-${data.commentId}`);
        }
        window.location.reload();
      } else {
        showflashmessage(data.status, data.message);
      }
    })
    .catch((error) => {
      console.error('Error adding comment:', error);
      showflashmessage(data.status, data.message);
    });
}

