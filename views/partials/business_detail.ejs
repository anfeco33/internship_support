<script>
  const businessId = '<%= data.businessId %>';
  const userRole = '<%= account.role %>';

  function initMap() {
    var companyLocation = { lat: <%= company.location.coordinates[1] %>, lng: <%= company.location.coordinates[0] %> };
    var map = new google.maps.Map(document.getElementById('map'), {
      zoom: 15,
      center: companyLocation
    });
    var marker = new google.maps.Marker({
      position: companyLocation,
      map: map
    });
  }

  function showMedia(type, src) {
    var carouselInner = document.querySelector('.carousel-inner');
    carouselInner.innerHTML = ''; // Clear existing items

    if (type === 'video') {
      var videoItem = document.createElement('div');
      videoItem.className = 'carousel-item active';
      videoItem.innerHTML = '<iframe width="100%" height="400px" src="' + src + '" title="Promotion Video" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>';
      carouselInner.appendChild(videoItem);
    } else if (type === 'image') {
      var imageItem = document.createElement('div');
      imageItem.className = 'carousel-item active';
      imageItem.innerHTML = '<img src="' + src + '" class="d-block w-100" alt="Company Image">';
      carouselInner.appendChild(imageItem);
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    tinymce.init({
      selector: '#greetingMessage',
      plugins: 'advlist autolink lists link image charmap preview anchor pagebreak',
      toolbar_mode: 'floating',
      height: 200,
    });

    const applyForm = document.getElementById('applyInternshipForm');
    if (applyForm) {
      applyForm.addEventListener('submit', function (event) {
        event.preventDefault();

        const applicantName = document.getElementById('applicantName').value.trim();
        const applicantEmail = document.getElementById('applicantEmail').value.trim();
        const greeting = tinymce.get('greetingMessage').getContent();
        const documents = document.getElementById('applicationDocuments').files;

        if (!applicantName || !applicantEmail || !greeting) {
          showflashmessage('warning', 'Please fill in all required fields.');
          return;
        }

        const formData = new FormData();
        formData.append('applicantName', applicantName);
        formData.append('applicantEmail', applicantEmail);
        formData.append('greeting', greeting);
        for (let file of documents) {
          formData.append('documents', file);
        }
        console.log('Form Data:', formData);
        console.log('Applying for internship:', applyingInternshipId);
        fetch(`/home/business/internship/${applyingInternshipId}/apply`, {
          method: 'POST',
          body: formData,
        })
          .then(response => {
            if (!response.ok) {
              console.error('Error response:', response);
              throw new Error('Failed to submit application');
            }
            return response.json();
          })
          .then(data => {
            console.log('Server Response:', data);
            if (data.status === 'success') {
              showflashmessage('success', 'Application submitted successfully!');
              location.reload();
            } else {
              showflashmessage('error', 'Error submitting application: ' + data.message);
            }
          })
          .catch(error => {
            console.error('Error submitting application:', error);
            showflashmessage('error', 'Error submitting application.');
          });
      });
    }
  });
  
  function applyForInternship(internshipId) {
    // student only
    if ('<%= account.role %>' !== 'student') {
      showflashmessage('warning', 'You should be a student to apply for internships');
      return;
    }
    applyingInternshipId = internshipId;

    const applyModal = new bootstrap.Modal(document.getElementById('applyInternshipModal'));
    applyModal.show();
  }

  function scrollThumbnails(direction) {
    var thumbnailWrapper = document.querySelector('.thumbnail-wrapper');
    if (direction === 'prev') {
      thumbnailWrapper.scrollBy({ left: -150, behavior: 'smooth' });
    } else if (direction === 'next') {
      thumbnailWrapper.scrollBy({ left: 150, behavior: 'smooth' });
    }
  }
</script>
