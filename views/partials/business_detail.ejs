function maskEmail(email) {
    const [localPart, domain] = email.split('@');
    const maskedLocalPart = localPart.slice(0, 2) + '*'.repeat(localPart.length - 4) + localPart.slice(-2);
    return maskedLocalPart + '@' + domain;
  }
const emailElements = document.querySelectorAll('.masked-email');
if (emailElements) {
  document.addEventListener('DOMContentLoaded', function () {
    emailElements.forEach(function (element) {
      const email = element.getAttribute('data-email');
      element.textContent = ' - ' + maskEmail(email);
    });

    const dateElements = document.querySelectorAll('.comment-date');
    dateElements.forEach(function (element) {
      const dateStr = element.getAttribute('data-date');
      const date = new Date(dateStr);
      element.textContent = date.toLocaleString();
    });
  });
}

function resetAllRatings() {
  resetStarsDirectly('workEnvironmentRating');
  resetStarsDirectly('trainingSupportRating');
  resetStarsDirectly('learningOpportunitiesRating');
  resetStarsDirectly('benefitsRating');
  document.getElementById('workEnvironmentRatingValue').value = '0';
  document.getElementById('trainingSupportRatingValue').value = '0';
  document.getElementById('learningOpportunitiesRatingValue').value = '0';
  document.getElementById('benefitsRatingValue').value = '0';
}

function resetStarsDirectly(ratingId) {
  const stars = document.querySelectorAll(`#${ratingId} .fa-star`);
  stars.forEach((star) => {
    star.classList.remove('hovered');
    star.classList.remove('selected');
    star.classList.remove('fa-solid');
    star.classList.add('fa-regular');
  });
}

function highlightStars(ratingId, starNumber) {
  const stars = document.querySelectorAll(`#${ratingId} .fa-star`);
  stars.forEach((star, index) => {
    if (index < starNumber) {
      star.classList.add('hovered');
      star.classList.remove('fa-regular');
      star.classList.add('fa-solid');
    } else {
      star.classList.remove('hovered');
      star.classList.remove('fa-solid');
      star.classList.add('fa-regular');
    }
  });
}

function resetStars(ratingId) {
  const stars = document.querySelectorAll(`#${ratingId} .fa-star`);
  stars.forEach((star) => {
    if (!star.classList.contains('selected')) {
      star.classList.remove('hovered');
      star.classList.remove('fa-solid');
      star.classList.add('fa-regular');
    }
  });
}

function setRating(ratingId, starNumber) {
  const stars = document.querySelectorAll(`#${ratingId} .fa-star`);
  stars.forEach((star, index) => {
    if (index < starNumber) {
      star.classList.add('selected');
      star.classList.remove('fa-regular');
      star.classList.add('fa-solid');
    } else {
      star.classList.remove('selected');
      star.classList.remove('fa-solid');
      star.classList.add('fa-regular');
    }
  });
  document.getElementById(`${ratingId}Value`).value = starNumber;
}

