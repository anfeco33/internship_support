<% const businessId = data.businessId ? data.businessId.toString() : ''; %>
<script>
    const businessId = '<%= data.businessId %>';
    const userRole = '<%= account.role %>';
</script>
<header>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/home">
                <img src="../../images/logo.png" alt="err" id="header-logo">
            </a>
            <div class="seach_bar d-flex justify-content-center align-items-center mb-3">
                <div class="seach_content  input-group mx-3">
                    <input type="text" class="form-control" name="search" id="searchInput" placeholder="Find companies, for example: FPT" data-bs-toggle="collapse" data-bs-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
                    <div class="input-group-append  d-flex justify-content-center align-items-center" >
                        <span id="clear_icon">
                            <i class="fa fa-times"></i>
                        </span>
                        <span id="seach_icon" class="input-group-text" 
                        style="height: 100%; border-radius:0px 5px 5px 0px; padding: 8.5px;">                       
                            <i class="fa fa-search" style="border-radius: 0px;"></i>
                        </span>
            
                    </div>
                    <div class="collapse custom-collapse" id="collapseExample">
                        <div class="card card-body search_result">
                            <ul id="search_result_row">
                                <!-- search result -->
                            </ul>    
                        </div>
                    </div>
                </div>
            
                <div class="bell_icon mx-3">
                  <i class="bi bi-bell-fill"></i>
                  <% if (account.role === 'company') { %>
                    <span id="applicationCount" class="badge">0</span>
                  <% } else if (account.role === 'student') { %>
                    <span id="studentFeedbackCount" class="badge">0</span>
                  <% } %>
                </div>

                <% if (account.role === 'student') { %>
                  <div id="studentFeedbackDropdown" class="applications-dropdown">
                    <ul id="studentFeedbackList" class="list-group">
                      <!-- Feedback items hiển thị ở đây -->
                    </ul>
                  </div>
                <% } %>

                <!-- nếu role company thì hiện nút update profile -->
                <% if (account.role === 'company') { %>
                  <!-- Applications Dropdown -->
                  <div id="applicationsDropdown" class="applications-dropdown">
                    <ul id="applicationsList" class="list-group">
                      <!-- Applications will be listed here -->
                    </ul>
                  </div>  
                    <div class="update_profile_icon mx-3" alt="update profile">
                        <button class="btn btn-primary btn-sm" onclick="editByBussinessId('<%= data.businessId %>')">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </div>
                    <div class="my_business_icon mx-3" alt="my business">
                        <a href="/home/business/<%= data.businessId %>" class="btn btn-secondary btn-sm my-business-btn">
                          <i class="fa fa-briefcase" style="margin-right: 10px;"></i>MY BUSINESS
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </nav>
</header>

<%- include('../partials/slide_board') %>
<div class="container mt-5">
    <div class="custom-alert" role="alert">
        <h2 class="title-type">THE TOP COMPANIES PROVIDING THE BEST INTERNSHIP SUPPORT</h2>
    </div>
        <!--  hiện thành card có width == height (nhỏ hơn 150px) trên cùng 1 dòng-->
        <!-- chỉnh css chế độ sáng/tối cho text trong /public/css/style.css-->
         <!-- image mỗi business có cùng kích thước -->
        <!-- company đã verified -->
    <div class="row">
      <% if (data.topSupportiveCompanies && data.topSupportiveCompanies.length > 0) { %>
        <% var topCompanies = data.topSupportiveCompanies %>
        <% if (topCompanies.length > 0) { %>
            <% topCompanies.forEach((company, index) => { 
                var rankClass = index === 0 ? 'top1' 
                              : index === 1 ? 'top2' 
                              : index === 2 ? 'top3' 
                              : 'default'; 
                var badgeClass = index === 0 ? 'badge-top1'
                              : index === 1 ? 'badge-top2'
                              : index === 2 ? 'badge-top3'
                              : 'badge-default';
            %>
            <div class="col-12 mb-4">
                <div class="normal-business-card <%= rankClass %>" onclick="getBusinessById('<%= company._id.toString() %>')">
                    <img src="<%= company.images.length > 0 ? company.images[0] : '/images/default_companyImage_details.jpg' %>" class="card-img-top-top" alt="<%= company.name %>">
                    <div class="card-body-top">
                        
                        <h5 class="card-title">
                            <%= company.name %>
                            <% if (company.isVerified) { %>
                            <img src="/images/verified_icon.png" alt="Verified" style="width: 30px; height: 30px;" id="verifiedIcon">
                            <% } else { %>
                            <img src="/images/unverified_icon.png" alt="Unverified" style="width: 30px; height: 30px;" id="unverifiedIcon">
                            <% } %>
                            <div class="card-header">
                              <span class="badge <%= badgeClass %>">
                                <% if (index === 0) { %>
                                  <img src="/images/1st.png" alt="1st">
                                <% } else if (index === 1) { %>
                                  <img src="/images/2nd.png" alt="2nd">
                                <% } else if (index === 2) { %>
                                  <img src="/images/3rd.png" alt="3rd">
                                <% } %>
                                </span>
                            </div>
                        </h5>
                        <p class="card-text" id="industry">Industry: <%= company.industry %></p>
                        <p class="card-text">
                          <% if (company.averageRating) { %>
                            <span class="stars" data-rating="<%= company.averageRating %>"></span>
                            (<%= company.averageRating.toFixed(1) %>/5)
                          <% } else { %>
                            <span class="stars" data-rating="0"></span>
                            (0/5)
                          <% } %>
                          <% if (company.comments && company.comments.length > 0) { %>  
                            <span class="text-muted"><%= company.comments.length %> reviews</span>
                          <% } else { %>
                            <span class="text-muted">(0 review)</span>
                          <% } %>
                        </p>
                        
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                          <p class="card-text" id="address" style="font-size: 10px;"><%= company.address %></p>
                          <% if (account.role === 'student') { %>
                            <% if (account.savedCompanies.includes(company._id.toString())) { %>
                              <p class="heart-icon iconheart">
                                <i class="fa fa-heart heart" id="heart-<%= company._id.toString() %>" onclick="saveFavoriteCompany(event, '<%= company._id.toString() %>')" style="font-size:30px;color:red;cursor:pointer;"></i>
                              </p>
                            <% } else { %>
                              <p class="heart-icon iconheart">
                                <i class="fa-regular fa-heart heart" id="heart-<%= company._id.toString() %>" onclick="saveFavoriteCompany(event, '<%= company._id.toString() %>')" style="font-size:30px;color:red;cursor:pointer;"></i>
                              </p>
                            <% } %>
                          <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% }); %>
        <% } %>
    <% } else { %>
        <div class="col-12">
            <p class="text-center">We would show you the most supportive companies for internships soon.</p>
        </div>
    <% } %>
    
    </div>
        
        
        
        

    <form id="filterForm" class="mb-4">
      <div class="row">
        <div class="col-md-3">
          <select class="form-select" id="filterIndustry" name="industry">
            <option value="">Select Industry</option>
            <option value="IT">IT</option>
            <option value="AI">AI</option>
            <option value="Marketing">Marketing</option>
            <option value="Finance">Finance</option>
            <option value="Healthcare">Healthcare</option>
            <option value="Education">Education</option>
            <option value="Manufacturing">Manufacturing</option>
            <option value="Retail">Retail</option>
            <option value="Construction">Construction</option>
            <option value="Transportation">Transportation</option>
            <option value="Real Estate">Real Estate</option>
            <option value="Telecommunications">Telecommunications</option>
            <option value="Energy">Energy</option>
            <option value="Hospitality">Hospitality</option>
            <option value="Legal">Legal</option>
            <option value="Agriculture">Agriculture</option>
            <option value="Media">Media</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Consulting">Consulting</option>
            <option value="Nonprofit">Nonprofit</option>
          </select>
        </div>
        <div class="col-md-3">
          <select class="form-select" id="filterSize" name="size">
            <option value="">Select Size</option>
            <option value="Small">Small</option>
            <option value="Medium">Medium</option>
            <option value="Large">Large</option>
          </select>
        </div>
        <div class="col-md-3">
          <select class="form-select" id="filterIsVerified" name="isVerified">
            <option value="">Select Verification Status</option>
            <option value="true">Verified</option>
            <option value="false">Unverified</option>
          </select>
        </div>
        <div class="col-md-3">
          <button type="submit" id="filter" class="btn btn-primary">
            <i class="fa fa-filter" style="font-size: 20px;"></i>
          </button>
          <button type="button" class="btn btn-secondary" id="showAllBtn" >View All </button>
        </div>
      </div>
    </form>
    <div class="row">
        <div class="custom-alert" role="alert">
            <h3 class="title-type" id="allCompanies">BELOW ARE COMPANIES ACTIVELY SEEKING TO RECRUIT INTERNS</h3>
        </div>
        <% if (data.listOfBusiness) { %>
          <% var list = data.listOfBusiness %>
          <% if (list.length > 0) { %>
              <% list.forEach((business) => { %>
                  <div class="col-12 mb-4">
                      <div class="business-card" onclick="getBusinessById('<%= business._id.toString() %>')">
                          <img 
                              src="<%= business.images.length > 0 ? business.images[0] : '/images/default_companyImage_details.jpg' %>" 
                              class="card-img-top" 
                              alt="<%= business.name %>"
                          >
                          <div class="card-body">
                              <h5 class="card-title">
                                  <%= business.name %>
                                  <% if (business.isVerified) { %>
                                      <img 
                                          src="/images/verified_icon.png" 
                                          alt="Verified"
                                      >
                                  <% } else { %>
                                      <img 
                                          src="/images/unverified_icon.png" 
                                          alt="Unverified"
                                      >
                                  <% } %>
                              </h5>
                              <p class="card-text" id="industry">Industry: <%= business.industry %></p>
                              <p class="card-text">
                                <% if (business.averageRating) { %>
                                  <span class="stars" data-rating="<%= business.averageRating %>"></span>
                                  (<%= business.averageRating.toFixed(1) %>/5)                                
                                <% } else { %>
                                  <span class="stars" data-rating="0"></span>
                                  (0/5)
                                <% } %>
                                <% if (business.comments && business.comments.length > 0) { %>
                                  <span class="text-muted"><%= business.comments.length %> reviews</span>
                                  <% } else { %>
                                  <span class="text-muted" class="text-muted">(0 review)</span>
                                <% } %>
                              </p>  
                              <p class="card-text" id="address" style="font-size: 10px;"><%= business.address %></p>
                              <% if (account.role === 'student') { %>
                                <% if (account.savedCompanies.includes(business._id.toString())) { %>
                                  <p class="heart-icon iconheart">
                                    <i class="fa fa-heart heart" id="heart-<%= business._id.toString() %>" onclick="saveFavoriteCompany(event, '<%= business._id.toString() %>')" style="font-size:30px;color:red;cursor:pointer;"></i>
                                  </p>
                                <% } else { %>
                                  <p class="heart-icon iconheart">
                                    <i class="fa-regular fa-heart heart" id="heart-<%= business._id.toString() %>" onclick="saveFavoriteCompany(event, '<%= business._id.toString() %>')" style="font-size:30px;color:red;cursor:pointer;"></i>
                                  </p>
                                <% } %>
                              <% } %>
                          </div>
                      </div>
                  </div>
              <% }); %>
          <% } else { %>
              <h2 id="empty-list" class="text-center">
                  Sorry, there are no appropriate businesses found.
              </h2>
          <% } %>
      <% } %>
    </div>

    <div class="pagination-container">
      <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
          <!-- Nút Previous -->
          <% if (data.currentPage > 1) { %>
            <li class="page-item">
              <a class="page-link" href="/business?page=<%= data.currentPage - 1 %>&limit=<%= data.limit %>" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
              </a>
            </li>
          <% } else { %>
            <li class="page-item disabled">
              <span class="page-link" aria-hidden="true">&laquo;</span>
            </li>
          <% } %>
    
          <!-- Danh sách các trang -->
          <% for (var i = 1; i <= data.totalPages; i++) { %>
            <li class="page-item <%= data.currentPage === i ? 'active' : '' %>">
              <a class="page-link" href="/business?page=<%= i %>&limit=<%= data.limit %>"><%= i %></a>
            </li>
          <% } %>
    
          <!-- Nút Next -->
          <% if (data.currentPage < data.totalPages) { %>
            <li class="page-item">
              <a class="page-link" href="/business?page=<%= data.currentPage + 1 %>&limit=<%= data.limit %>" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
              </a>
            </li>
          <% } else { %>
            <li class="page-item disabled">
              <span class="page-link" aria-hidden="true">&raquo;</span>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>    
  </div>

<%- include('../partials/footer') %>