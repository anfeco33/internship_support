<% if (account) { %>
    <% const businessId = data.businessId ? data.businessId.toString() : ''; %>
    <div class="container-fluid light-style flex-grow-1 container-p-y profile_page">
        <div class="card">
            <div class="row no-gutters row-bordered row-border-light">
                <div class="col col-lg-4 col-12 pt-0">
                    <div class="list-group list-group-flush account-settings-links">
                        <div class="avatar media align-items-center">
                            <img src='<%= account.profilePicture%>' alt class="d-block ui-w-80">
                            <div class="full_name">
                                <%= account.fullName%>
                            </div>
                        </div>
                        <!-- <div class="alert alert-success d-flex align-items-center" role="alert">
                            <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Success:">
                                <use xlink:href="#check-circle-fill" />
                            </svg>
                            <div>
                                Authorized account: <strong>
                                    account.role %>
                                </strong>
                            </div>
                        </div> -->
                        <% if (account.role === 'company' && data.company) { %>
                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Success:">
                                    <use xlink:href="#check-circle-fill" />
                                </svg>
                                <div>           
                                    <% if (data.company.name) { %>                        
                                    Account representative of
                                    <strong>                        
                                            <%= data.company.name%>
                                    </strong>
                                    <% } else { %>
                                        You haven't registered your company yet
                                    <% } %>    
                                </div>            
                            </div>
                        <% } %>
                        <a class="list-group-item list-group-item-action active" data-bs-toggle="tab"
                            href="#account">Account</a>
                        <% if (account.role === 'admin') { %>
                            <a class="list-group-item list-group-item-action" data-bs-toggle="tab"
                            href="#password">Password</a>
                        <% } %>
                        
                        <a class="list-group-item list-group-item-action" data-bs-toggle="tab"
                            href="#fav-com-list">Favorite Companies</a>
                    </div>
                </div>
                <!-- //TODO: sửa lại thành form -->
                <div class="col col-lg-8 col-12">
                    <div class="tab-content">
                        <div class="tab-pane fade active show" id="account">

                            <div class="card-body">

                                <form enctype="multipart/form-data" class="row g-3">
                                    <label for="customFile" class="form-label">Change avatar</label>
                                    <div class="col-auto">

                                        <input class="form-control" type="file" class="custom-file-input"
                                            id="customFile">
                                    </div>
                                    <div class="col-auto">
                                        <button id="upload" class="btn btn-success px-5"
                                            onclick="uploadFiles(event , '/upload/avatar')">Upload</button>
                                    </div>
                                    <div>
                                        <div class="progress" style="display: none;">
                                            <div class="progress-bar progress-bar-striped bg-success" role="progressbar"
                                                aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>

                                </form>

                                <form method="POST">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Email <strong>(Non-editable)</strong></label>
                                        <input type="text" class="form-control mb-1" value="<%= account.email%>"
                                            placeholder="username" disabled>
                                    </div>
                                    <div class="form-group mb-3">
                                        <!-- <label class="form-label">Fullname</label>-->
                                        <label class="form-label">
                                            <% if (account.role === 'student') { %>
                                                Student's Full Name
                                            <% } else if (account.role === 'company') { %>
                                                Company's Representative Name
                                            <% } else { %>
                                                Name
                                            <% } %>
                                        </label>
                                        <input type="text" class="form-control" value="<%= account.fullName%>"
                                            placeholder="Fullname" name="fullname">
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">Date of joining <strong>(Non-editable)</strong></label>
                                        <input type="text" class="form-control" value="<%= account.createdAt%>"
                                            placeholder="Time" disabled>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">Last login <strong>(Non-editable)</strong></label>
                                        <input type="text" class="form-control" value="<%= account.lastLogin%>"
                                            placeholder="Last login" disabled>
                                    </div>
                                    <div class="d-flex justify-content-end">
                                        <button type="submit" class="btn btn-primary btn-lg" id="change_fullname"
                                            onclick="changeFullname(event)">Save</button>
                                    </div>
                                </form>
                                <hr class="border-light m-0">
                            </div>

                        </div>

                        <div class="tab-pane fade" id="password">
                            <div class="card-body pb-2">
                                <form method="POST">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Current password</label>
                                        <input type="password" class="form-control" placeholder="Current password"
                                            name="currpass">
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">New password</label>
                                        <input type="password" class="form-control" placeholder="New password"
                                            name="newpass">
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="form-label">Repeat new password</label>
                                        <input type="password" class="form-control" placeholder="Repeat new password"
                                            name="renewpass">
                                    </div>
                                    <button type="submit" class="btn btn-primary" id="change_password"
                                        onclick="changePassword(event)">Save</button>&nbsp;
                                </form>

                            </div>
                        </div>

                        <!-- FAVORITE LIST -->
                        <div class="tab-pane fade" id="fav-com-list">
                            <div class="card-body pb-2">
                                <div class="row">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header">
                                                <h4 class="form-label">Your Favorite Companies</h4>
                                            </div>
                                            <div class="card-body pb-2" style="max-height: 400px; overflow-y: auto;">
                                                <div class="row" id="favoriteCompanies">
                                                    <!-- show list -->
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                            
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
    <% } %>
<script>

    async function loadFavoriteCompanies() {
        try {
        const response = await fetch('/home/favorites');
        const result = await response.json();

        if (result.status === 'success') {
            const favoriteContainer = document.getElementById('favoriteCompanies');
            favoriteContainer.innerHTML = ''; // Xóa danh sách cũ

            result.companies.forEach(company => {
            const companyCard = `
                <div class="col-12 mb-3">
                    <div class="card-fav flex-row" onclick="navigateToCompany('${company._id}')">
                        <img src="${company.images.length > 0 ? company.images[0] : '/images/default_companyImage_details.jpg'}" class="card-img-left" alt="${company.name}">
                        <div class="card-body-fav">
                            <h5 class="card-title-fav d-flex justify-content-between align-items-center">
                                ${company.name}
                                <i class="fa fa-heart heart" onclick="removeFavoriteCompany(event, '${company._id}')" style="font-size:24px;color:red;cursor:pointer;"></i>
                            </h5>
                            <p class="card-industry-text-fav">${company.industry}</p>
                            <p class="card-address-text-fav">${company.address}</p>
                        </div>
                    </div>
                </div>
            `;
            favoriteContainer.insertAdjacentHTML('beforeend', companyCard);
            });
        } else {
            showflashmessage(result.status, result.message);
        }
        } catch (error) {
            showflashmessage('error', 'Error loading favorite companies');
            console.error('Error loading favorite companies:', error);
        }
    }
    async function removeFavoriteCompany(event, companyId) {
        event.stopPropagation();
        try {
        const response = await fetch('/home/toggle-favorite', {
            method: 'POST',
            headers: {
            'Content-Type': 'application/json',
            },
            body: JSON.stringify({ companyId }),
        });

        const result = await response.json();

        if (result.status === 'success') {
            showflashmessage(result.status, result.message);
            loadFavoriteCompanies();
        } else {
            showflashmessage(result.status, result.message);
        }
        } catch (error) {
            showflashmessage('error', 'Error removing favorite company');
            console.error('Error removing favorite company:', error);
        }
    }
    function navigateToCompany(companyId) {
        window.location.href = `/home/business/${companyId}`;
    }

  document.addEventListener('DOMContentLoaded', loadFavoriteCompanies);

</script>
<%- include('../partials/flash-message') %>