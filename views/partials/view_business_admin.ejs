<div class="update_business">
    <div class="container mt-5">
        
        <div class="row">
            <div class="alert alert-primary d-flex justify-content-between align-items-center" role="alert">
                <h2>
                    BUSINESS PROFILE 
                    <% if (data.company.isVerified) { %>
                        <img src="/images/verified_icon.png" alt="Verified" style="width: 50px;">
                    <% } else { %>
                        <img src="/images/unverified_icon.png" alt="Unverified" style="width: 50px;">
                    <% } %>
                </h2>
                <div>
                    <% if (data.company.isVerified) { %>
                        <button class="btn btn-warning me-2" onclick="toggleVerification('<%= data.company._id %>', false)">
                            <i class="fa fa-times-circle"></i> Unverify
                        </button>
                    <% } else { %>
                        <button class="btn btn-success me-2" onclick="toggleVerification('<%= data.company._id %>', true)">
                            <i class="fa fa-check-circle"></i> Verify
                        </button>
                    <% } %>
                    <% if (data.company.isLocked) { %>
                        <button class="btn btn-success" onclick="toggleLockProfile('<%= data.company._id %>', false)">
                          <i class="fa fa-unlock"></i> Unlock Profile
                        </button>
                    <% } else { %>
                        <button class="btn btn-danger" onclick="toggleLockProfile('<%= data.company._id %>', true)">
                          <i class="fa fa-lock"></i> Remove Profile
                        </button>
                    <% } %>
                </div>
            </div>
        </div>
            <!-- Tên công ty -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputBusinessName" class="col-sm-2 col-form-label">Business Name
                        <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="inputBusinessName" name="name" placeholder="Business Name" 
                        value="<%= data.company.name %>"
                        readonly>
                    </div>
                </div>
            </div>

            <!-- Lĩnh vực hoạt động -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputIndustry" class="col-sm-2 col-form-label">Industry
                        <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-10">
                        <select class="form-select" id="inputIndustry" name="industry" disabled>
                            <option value="" disabled selected>Select Industry</option>
                            <option value="IT" <%= data.company.industry === 'IT' ? 'selected' : '' %>>IT</option>
                            <option value="Marketing" <%= data.company.industry === 'Marketing' ? 'selected' : '' %>>Marketing</option>
                            <option value="Finance" <%= data.company.industry === 'Finance' ? 'selected' : '' %>>Finance</option>
                            <option value="Healthcare" <%= data.company.industry === 'Healthcare' ? 'selected' : '' %>>Healthcare</option>
                            <option value="Education" <%= data.company.industry === 'Education' ? 'selected' : '' %>>Education</option>
                            <option value="Manufacturing" <%= data.company.industry === 'Manufacturing' ? 'selected' : '' %>>Manufacturing</option>
                            <option value="Retail" <%= data.company.industry === 'Retail' ? 'selected' : '' %>>Retail</option>
                            <option value="Construction" <%= data.company.industry === 'Construction' ? 'selected' : '' %>>Construction</option>
                            <option value="Transportation" <%= data.company.industry === 'Transportation' ? 'selected' : '' %>>Transportation</option>
                            <option value="Real Estate" <%= data.company.industry === 'Real Estate' ? 'selected' : '' %>>Real Estate</option>
                            <option value="Telecommunications" <%= data.company.industry === 'Telecommunications' ? 'selected' : '' %>>Telecommunications</option>
                            <option value="Energy" <%= data.company.industry === 'Energy' ? 'selected' : '' %>>Energy</option>
                            <option value="Hospitality" <%= data.company.industry === 'Hospitality' ? 'selected' : '' %>>Hospitality</option>
                            <option value="Legal" <%= data.company.industry === 'Legal' ? 'selected' : '' %>>Legal</option>
                            <option value="Agriculture" <%= data.company.industry === 'Agriculture' ? 'selected' : '' %>>Agriculture</option>
                            <option value="Media" <%= data.company.industry === 'Media' ? 'selected' : '' %>>Media</option>
                            <option value="Entertainment" <%= data.company.industry === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
                            <option value="Consulting" <%= data.company.industry === 'Consulting' ? 'selected' : '' %>>Consulting</option>
                            <option value="Nonprofit" <%= data.company.industry === 'Nonprofit' ? 'selected' : '' %>>Nonprofit</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Quy mô công ty -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputSize" class="col-sm-2 col-form-label">Company Size</label>
                    <div class="col-sm-10">
                        <select id="inputSize" name="size" class="form-select" disabled>
                            <option value="Small" <%= data.company.size === 'Small' ? 'selected' : '' %>>Small</option>
                            <option value="Medium" <%= data.company.size === 'Medium' ? 'selected' : '' %>>Medium</option>
                            <option value="Large" <%= data.company.size === 'Large' ? 'selected' : '' %>>Large</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Website -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputWebsite" class="col-sm-2 col-form-label">Website
                        <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-10">
                        <input type="url" class="form-control" id="inputWebsite" name="website" 
                        value="<%= data.company.website %>"
                        placeholder="https://example.com" readonly>
                    </div>
                </div>
            </div>

            <!-- Mô tả -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputProfile" class="col-sm-2 col-form-label">Profile Description</label>
                    <div class="col-sm-10">
                        <textarea class="form-control" id="inputProfile" name="profile" rows="3" 
                        placeholder="The company has not updated their profile yet" readonly>
                        <%= data.company.profile %>
                        </textarea>
                    </div>
                </div>
            </div>

            <!-- Email liên hệ -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputContactEmail" class="col-sm-2 col-form-label">Contact Email
                        <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-10">
                        <input type="email" class="form-control" id="inputContactEmail" name="contactEmail" 
                        value="<%= data.company.contactEmail %>"
                        placeholder="Contact Email" readonly>
                    </div>
                </div>
            </div>

            <!-- Số điện thoại -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputPhoneNumber" class="col-sm-2 col-form-label">Phone Number
                        <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-10">
                        <input type="tel" class="form-control" id="inputPhoneNumber" name="phoneNumber"
                        value="<%= data.company.phoneNumber %>"
                        placeholder="Phone Number" readonly>
                    </div>
                </div>
            </div>
            <!-- Địa chỉ -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputAddress" class="col-sm-2 col-form-label">Address
                        <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="inputAddress" name="address" 
                        placeholder="Address" 
                        value="<%= data.company.address %>"
                        readonly>
                    </div>
                </div>
            </div>
            <!-- Địa chỉ với Google Maps API -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputLocation" class="col-sm-2 col-form-label">Location</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="inputLocation" name="location" placeholder="Move the marker below to your business location"
                        value="<%= data.company.location.coordinates[1] %>, <%= data.company.location.coordinates[0] %>"
                        readonly>
                        <div id="map" class="mt-3" style="height: 300px; width: 100%;"></div>
                    </div>
                </div>
            </div>

            <!-- Danh sách hình ảnh -->
            <div class="col-12 mb-3">
                <div class="row">
                    <label for="inputImages" class="col-sm-2 col-form-label">Company Images</label>
                    <div class="col-sm-10">
                        <!-- Input để upload ảnh -->
                        <input type="file" id="inputImages" name="images" class="form-control" accept="image/*" multiple disabled>
                        
                        <!-- Khu vực preview các ảnh đã lưu -->
                        <div id="imagePreview" class="mt-3 d-flex flex-wrap">
                            <% if (data.company.images && data.company.images.length > 0) { %>
                                <% data.company.images.forEach(function(image) { %>
                                    <img src="<%= image %>" class="img-thumbnail me-2" style="width: 100px; height: 100px;" onclick="showImageModal('<%= image %>')">
                                <% }); %>
                            <% } else { %>
                                <p class="text-muted">No images uploaded to display.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Video quảng cáo -->
            <div class="form-group">
                <label for="inputPromotionVideo"><strong>YouTube Promotion Video Embed Link</strong></label>
            </div>
            
            <div id="promotionVideoPreview" class="mt-3">
                <!-- Video preview will be shown here -->
                <% if (data.company.promotionVideos && data.company.promotionVideos.length > 0) { %>
                    <iframe class="embed-responsive-item" src="<%= data.company.promotionVideos[0] %>" allowfullscreen></iframe>
                <% } else { %>
                    <p class="text-muted">No promotion video available.</p>
                <% } %>
            </div>            

            <!-- Document Upload -->
            <div class="form-group">
                <label for="inputDocuments" class="col-sm-2 col-form-label"><strong>Business Documents
                    <span class="text-danger">*</span></strong></label>

                <div class="col-sm-15">
                    <input type="file" class="form-control" id="inputDocuments" name="documents" 
                    multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" disabled>
                    <div id="documentPreview" class="mt-3">
                        <% if (data.company.documents && data.company.documents.length > 0) { %>
                            <ul class="list-group">
                                <% data.company.documents.forEach(function(document) { %>
                                    <li class="list-group-item">
                                        <a href="<%= document %>" target="_blank"><%= document.split('/').pop() %></a>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted">No documents uploaded to display.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    window.companyId = "<%= data.companyId %>";
</script>

<script 
src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBs2CCj3DSth7s_9YHuG5EazDGskh5uKGk&libraries=places&callback=initMap" 
async 
defer>
</script>
<script src="/javascripts/update-business.js"></script>

<%- include('../partials/flash-message') %>
<%- include('../partials/css-library') %>
<%- include('../partials/footer') %>
